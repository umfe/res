# =========================================================
# 🌳 Monorepo Root .gitignore
# 我无语了 QAQ
# =========================================================
.env

# =========================
# 🧱 Node.js & 通用构建产物
# =========================
node_modules/
dist/
dist-ssr/
build/
out/
*.local
.tmp/
.cache/
coverage/
*.sw?

# =========================
# 📦 包管理器缓存
# =========================
.pnpm-store/
.yarn/
!.yarn/releases/
.npm/
.npmrc

# =========================
# 🧩 编辑器配置
# =========================

# VSCode
# .vscode/*
# 保留推荐插件与调试配置
# !.vscode/extensions.json
# !.vscode/launch.json
# !.vscode/*.code-snippets

# JetBrains / WebStorm / IntelliJ
.idea/
# 如果希望团队共享统一的代码风格，可保留部分配置：
# !.idea/codeStyles/
# !.idea/inspectionProfiles/

# =========================
# 🧪 日志与调试文件
# =========================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# =========================
# ⚙️ 环境变量文件
# =========================
.env
.env.production
.env.development
.env.local
.env*.local

# =========================
# ☁️ 部署与平台相关
# =========================
.vercel/
.netlify/
firebase-debug.log
functions/.runtimeconfig.json

# =========================
# 💻 系统文件
# =========================
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln

# =========================
# 🧰 工具类（可选）
# =========================
# Lerna / Turbo / Nx 等
.lerna/
.turbo/
.nx/

